# --- Base de Datos (SQL Server) ---
DB_USER=
DB_PASSWORD=
DB_SERVER=localhost
DB_NAME=CTIRECEPDB
DB_INSTANCE=MSSQLSERVER

# --- Servidor ---
# Puerto en que corre el backend (por defecto: 3000)
PORT=3000
